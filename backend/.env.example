# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Steam Web API key - https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# OpenID return/realm URLs for the Steam login flow. For local development
# these normally match this backend's own base URL.
STEAM_RETURN_URL=http://localhost:3000/auth/steam/return
STEAM_REALM=http://localhost:3000

# Secret used to sign session cookies. Required - the server refuses to
# start without it. Use a long, random, unguessable value in any real
# environment (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
SESSION_SECRET=replace_with_a_long_random_value

# Optional - defaults to 3000 if not set.
PORT=3000

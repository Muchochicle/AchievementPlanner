# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Steam Web API key - https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# OpenID return/realm URLs for the Steam login flow. For local development
# these normally match this backend's own base URL.
STEAM_RETURN_URL=http://localhost:3000/auth/steam/return
STEAM_REALM=http://localhost:3000

# Secret used to sign session cookies. Required - the server refuses to
# start without it, and refuses to start with fewer than 32 characters.
# Use a long, random, unguessable value in any real environment
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`,
# which produces 64 characters).
SESSION_SECRET=replace_with_a_long_random_value

# Optional - defaults to 3000 if not set.
PORT=3000

# Comma-separated list of origins allowed to call this API with credentials
# (CORS). Must exactly match scheme+host+port of every frontend origin -
# no trailing slashes, no wildcards (credentials:true forbids "*").
# Optional - defaults to the local Live Server origins below if not set,
# so local development needs no change here.
# Local (default):   http://127.0.0.1:5500,http://localhost:5500
# Production example: https://achievementplanner.example.com
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Where to send the browser after a successful Steam login - must be the
# frontend's own origin (no trailing slash needed, one is stripped if
# present). Optional - defaults to the local frontend origin if not set.
# Local (default):    http://localhost:5500
# Production example: https://achievementplanner.example.com
FRONTEND_URL=http://localhost:5500

# Whether session cookies are marked Secure (HTTPS-only). Optional -
# defaults to "false" if not set, which is required for local HTTP
# development (a Secure cookie is silently dropped over plain HTTP).
# Set to "true" in any real HTTPS deployment.
# Local (default): false
# Production:      true
COOKIE_SECURE=false

# Whether to trust the "X-Forwarded-*" headers from a reverse proxy /
# load balancer in front of this server. Optional - defaults to "false".
# Only set to "true" when this server sits behind a TLS-terminating
# proxy (the common shape for production HTTPS) - it's what lets
# COOKIE_SECURE=true work correctly in that setup. Leave "false" for
# local development and for any deployment with no proxy in front.
# Local (default): false
# Production:      true (only if deployed behind a TLS-terminating proxy)
TRUST_PROXY=false

# Path to the local SQLite leaderboard database file (Podiums -
# backend/services/leaderboardDb.js). Optional - defaults to
# backend/data/achievementplanner.db if not set. The containing directory
# is created automatically if it doesn't exist yet. Never committed (see
# .gitignore) - point this at persistent storage in any deployment where
# the default path wouldn't survive a restart/redeploy.
# Local (default): backend/data/achievementplanner.db
DATABASE_PATH=
